{
  "name": "scrutio-investigator",
  "private": true,
  "version": "0.1.0",
  "description": "Deterministic, evidence-backed payment incident investigation.",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test apps/api/src/services/payment-status-service.test.ts apps/api/src/services/auth-service.test.ts apps/api/src/services/investigation-engine.test.ts",
    "test:integration": "node --env-file=.env --import tsx --test apps/api/src/infrastructure/postgres.integration.test.ts apps/api/src/infrastructure/auth.integration.test.ts apps/api/src/infrastructure/operational-data.integration.test.ts",
    "migrate": "node --env-file=.env --import tsx apps/api/src/infrastructure/migrations/run-migrations.ts",
    "dev": "tsx watch apps/api/src/server.ts",
    "start": "node dist/apps/api/src/server.js"
  },
  "dependencies": {
    "@google/genai": "2.31.0",
    "express": "5.3.0",
    "pg": "8.16.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  }
}
